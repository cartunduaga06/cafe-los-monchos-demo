[Unit]
Description=Monchos Coffie private development preview
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/dev/cafe-los-monchos-pages-standalone
ExecStart=/usr/bin/python3 %h/dev/cafe-los-monchos-pages-standalone/scripts/dev.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=default.target
